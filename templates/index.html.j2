<!DOCTYPE html>
<html lang="et">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ ansible_facts["hostname"] }} | Ansible Lab 2</title>

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #111827, #1f2937);
            color: white;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .card {
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.15);
            border-radius: 20px;
            padding: 40px;
            width: 420px;
            box-shadow: 0 20px 50px rgba(0,0,0,0.35);
            backdrop-filter: blur(10px);
        }

        h1 {
            margin-top: 0;
            font-size: 32px;
        }

        .status {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 20px;
            background: #22c55e;
            color: #052e16;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .info {
            margin-top: 20px;
        }

        .row {
            margin: 12px 0;
            padding: 12px;
            background: rgba(255,255,255,0.06);
            border-radius: 10px;
        }

        .label {
            color: #9ca3af;
            font-size: 13px;
        }

        .value {
            font-size: 18px;
            margin-top: 4px;
            font-weight: bold;
        }

        .footer {
            margin-top: 25px;
            color: #9ca3af;
            font-size: 13px;
        }
    </style>
</head>

<body>
    <div class="card">
        <div class="status">ONLINE</div>

        <h1>Ansible Web Server</h1>

        <div class="info">
            <div class="row">
                <div class="label">HOSTNAME</div>
                <div class="value">{{ ansible_facts["hostname"] }}</div>
            </div>

            <div class="row">
                <div class="label">IP-AADRESS</div>
                <div class="value">{{ ansible_facts["default_ipv4"]["address"] }}</div>
            </div>

            <div class="row">
                <div class="label">OPERATSIOONISÜSTEEM</div>
                <div class="value">
                    {{ ansible_facts["distribution"] }}
                    {{ ansible_facts["distribution_version"] }}
                </div>
            </div>
        </div>

        <div class="footer">
            Leht genereeriti automaatselt Ansible playbookiga.
        </div>
    </div>
</body>
</html>
